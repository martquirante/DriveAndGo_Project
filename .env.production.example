# ===================================================================
# DRIVE&GO AZURE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Use this reference when setting "Environment Variables" or "App Settings"
# in Azure App Service (Configuration > Application settings) or Azure Container Apps.
# ===================================================================

# ── 1. ASP.NET CORE RUNTIME ──
ASPNETCORE_ENVIRONMENT=Production
PORT=8080
WEBSITES_PORT=8080
ENABLE_SWAGGER=false

# ── 2. PRIMARY CLOUD DATABASE: MICROSOFT AZURE ──
# Set USE_LOCAL_DB="false" so the API operates in Cloud mode
USE_LOCAL_DB=false

# Azure Database for PostgreSQL (Flexible Server) - PRIMARY DATABASE
AZURE_POSTGRES_CONNECTION_STRING=Host=driveandgo-primary.postgres.database.azure.com;Port=5432;Database=driveandgo_prod_db;Username=driveandgo_admin;Password=YOUR_AZURE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Keepalive=30;Maximum Pool Size=50;

# ── 3. SECONDARY BACKUP DATABASE: SUPABASE (AUTOMATIC FAILOVER & STANDBY) ──
# Supabase acts as the hot-standby disaster recovery backup.
# If Azure PostgreSQL is unreachable, DbFailoverEngine automatically switches to Supabase in 2 seconds.
SUPABASE_CONNECTION_STRING=Host=aws-1-ap-southeast-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.mvnswnhnhstzeritaeou;Password=YOUR_SUPABASE_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Keepalive=30;Connection Idle Lifetime=15;Maximum Pool Size=20;Multiplexing=false;No Reset On Close=true;

# Optional: Set USE_BACKUP_DB="true" if you want to force maintenance mode on Supabase
USE_BACKUP_DB=false

# ── 4. SUPABASE CLOUD FILE STORAGE (AVATARS & DOCUMENTS ARCHIVE) ──
SUPABASE_URL=https://mvnswnhnhstzeritaeou.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── 5. JWT ZERO-TRUST AUTHENTICATION ──
JWT_SECRET_KEY=DriveAndGo-Production-SuperSecret-JWT-Key-2026-ReplaceInLive!
JWT_ISSUER=DriveAndGoAPI
JWT_AUDIENCE=DriveAndGoClients

# ── 6. FIREBASE REALTIME DATABASE ──
FIREBASE_PROJECT_ID=vechiclerentaldb
FIREBASE_DATABASE_URL=https://vechiclerentaldb-default-rtdb.asia-southeast1.firebasedatabase.app

# ── 7. MULTI-MODEL CLOUD AI KEYS ──
SAMBANOVA_API_KEY=YOUR_SAMBANOVA_KEY
GROQ_API_KEY=YOUR_GROQ_KEY
COHERE_API_KEY=YOUR_COHERE_KEY
GEMINI_API_KEY=YOUR_GEMINI_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
HUGGINGFACE_API_KEY=YOUR_HUGGINGFACE_KEY

# ── 8. EMAIL & WEATHER NOTIFICATIONS ──
SMTP_EMAIL=YOUR_GMAIL_OR_SUPPORT_EMAIL
SMTP_APP_PASSWORD=YOUR_SMTP_PASSWORD
RESEND_API_KEY=YOUR_RESEND_KEY
WEATHERAPI_KEY=YOUR_WEATHERAPI_KEY
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY
