<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>$(NoWarn);MSB3277;CS8600;CS8602;CS8603;CS8618;CS8632</NoWarn>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="DriveAndGo_Admin\**" />
	  <Content Remove="DriveAndGo_Admin\**" />
	  <EmbeddedResource Remove="DriveAndGo_Admin\**" />
	  <None Remove="DriveAndGo_Admin\**" />
	</ItemGroup>
	<ItemGroup>
		<!-- Core & Swagger (Swashbuckle 6.x is compatible with Microsoft.OpenApi 1.x) -->
		<PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
		<PackageReference Include="QRCoder" Version="1.6.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
		<PackageReference Include="itext7" Version="9.6.0" />
		<PackageReference Include="itext7.bouncy-castle-adapter" Version="9.6.0" />

		<!-- PostgreSQL / Supabase -->
		<PackageReference Include="Npgsql" Version="9.0.4" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<!-- JWT Authentication -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.12.0" />

		<!-- Firebase Admin SDK -->
		<PackageReference Include="FirebaseAdmin" Version="3.1.0" />

		<!-- .env file loader -->
		<PackageReference Include="DotNetEnv" Version="3.1.1" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="EmailTemplates\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		<Content Update="Resources\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- ═══════════════════════════════════════════════════════════════════════
	     AUTO-UNBLOCK & AUTHENTICODE DEV SIGNING:
	     Executes Sign-Dev.ps1 to create/trust DriveAndGoDevCert, strip Mark-of-the-Web,
	     and sign all output binaries to resolve 0x800711C7 (Smart App Control).
	════════════════════════════════════════════════════════════════════════ -->
	<Target Name="SignOutput" AfterTargets="Build">
		<Exec Command="powershell -ExecutionPolicy Bypass -NoProfile -NonInteractive -File &quot;$(ProjectDir)Sign-Dev.ps1&quot; -TargetPath &quot;$(TargetPath)&quot;" ContinueOnError="true" />
	</Target>

</Project>
