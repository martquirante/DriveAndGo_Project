# ============================================================
#  DriveAndGo API — Environment Variables Template
#  Copy this to .env and fill in your values
# ============================================================

SUPABASE_CONNECTION_STRING=Host=YOUR_SUPABASE_HOST;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:your-app-id
FIREBASE_CREDENTIAL_PATH=firebase-adminsdk.json

JWT_SECRET_KEY=YourSuperSecretJWTKeyHere-MinimumOf32Characters
JWT_ISSUER=DriveAndGoAPI
JWT_AUDIENCE=DriveAndGoClients
JWT_EXPIRE_DAYS=30

LOCAL_DB_CONNECTION=Host=localhost;Port=5432;Database=driveandgo_db;Username=postgres;Password=postgres_dev_password;
